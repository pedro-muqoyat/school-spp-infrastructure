# =========================================================================
# TEMPLATE INFRASTRUKTUR SISTEM PEMBAYARAN SPP SEKOLAH (LARAVEL 11)
# Kredensial Asli Disamarkan Demi Keamanan Repositori Publik
# =========================================================================

APP_NAME="SPP Sekolah"
APP_ENV=production
APP_KEY=base64:AutomatedGeneratedKeyPlaceholder...
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://nama-sekolah.sch.id

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=spp_sekolah_production
DB_USERNAME=spp_operator_prod
DB_PASSWORD=MasukkanPasswordSangatKuatDisini!

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

FRANKENPHP_CONFIG="worker /var/www/html/public/index.php 10"

BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=your_pusher_app_id
PUSHER_APP_KEY=your_pusher_app_key
PUSHER_APP_SECRET=your_pusher_app_secret
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

CLOUDFLARED_TOKEN=MASUKKAN_TUNNEL_TOKEN_ANDA_DISINI
